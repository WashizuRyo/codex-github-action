{
  "name": "codex-github-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bridge": "./index.mjs",
    "bridge-acp-relay": "./acp-relay.mjs"
  },
  "scripts": {
    "start": "node --env-file=.env index.mjs serve",
    "test": "node --test",
    "tunnel": "node scripts/wrangler.mjs tunnel",
    "worker:check": "node scripts/wrangler.mjs check",
    "worker:deploy": "node scripts/wrangler.mjs deploy",
    "worker:dev": "node scripts/wrangler.mjs dev",
    "worker:tail": "node scripts/wrangler.mjs tail"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  }
}
