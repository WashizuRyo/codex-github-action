{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__CLOUDFLARE_WORKER_NAME__",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vpc_services": [
    {
      "binding": "BRIDGE",
      "service_id": "__CLOUDFLARE_VPC_SERVICE_ID__",
      "remote": true
    }
  ]
}
